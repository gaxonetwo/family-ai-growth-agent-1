# Only the explicit live mode may use these DeepSeek settings.
# Never commit a real API key. The default test path uses MockIntentProvider.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

INTENT_MODEL_TIMEOUT=
INTENT_MODEL_MAX_RETRIES=
INTENT_MAX_INPUT_LENGTH=
INTENT_CONFIDENCE_THRESHOLD=
INTENT_MAX_OUTPUT_TOKENS=
